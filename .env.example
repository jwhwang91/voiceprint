# ─────────────────────────────────────────────
# voiceprint — 환경 변수 예시. 이 파일을 .env 로 복사해 채우세요.
#   copy .env.example .env   (Windows)  /  cp .env.example .env  (macOS·Linux)
# ─────────────────────────────────────────────

# ── 네이버 계정 ──
# 비워두면 발행 시 브라우저 창에서 직접 로그인(권장 — 캡차/봇 탐지 회피).
# 채우면 .env 값으로 자동 로그인을 시도합니다.
NAVER_ID=
NAVER_PW=

# ── 브라우저 동작 (config/settings.yaml 의 browser.* 를 덮어씀) ──
# 네이버 봇 탐지 회피를 위해 기본 false(창이 보임)를 권장합니다.
HEADLESS=false
# 사람처럼 보이도록 동작 사이 지연(밀리초).
SLOW_MO_MS=80

# 경로·발행·수집·답방 등 그 밖의 모든 설정은 config/settings.yaml 에서 관리합니다.

# ── Naver Blog Growth Agent (SEO 레이어) ──
#  ⚠️ 실제 key/secret 값은 여기(.env.example)에 넣지 말 것. .env 에만 채운다. .env 는 .gitignore 됨.
#  값이 비어 있으면 해당 기능은 자동 skip 되고, 전체 파이프라인은 죽지 않는다(크롤링 폴백/완만 실패).

# 네이버 Open API (검색/데이터랩) — https://developers.naver.com
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
NAVER_SEARCH_BLOG_API_URL=https://openapi.naver.com/v1/search/blog.json
NAVER_DATALAB_SEARCH_API_URL=https://openapi.naver.com/v1/datalab/search
NAVER_DATALAB_SHOPPING_API_URL=https://openapi.naver.com/v1/datalab/shopping

# 네이버 검색광고 API (선택 — 3종이 모두 있을 때만 사용. 없으면 자동 skip)
NAVER_SEARCHAD_BASE_URL=https://api.searchad.naver.com
NAVER_SEARCHAD_ACCESS_LICENSE=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=

# SEO 동작 토글/한도 (config/blog_growth.yaml 의 naver_api/crawler 를 덮어씀)
NAVER_KEYWORD_USE_OPEN_API=true
NAVER_KEYWORD_USE_SEARCHAD_API=false
NAVER_KEYWORD_USE_CRAWLING_FALLBACK=true
NAVER_KEYWORD_DAILY_LIMIT=300
NAVER_KEYWORD_REQUEST_MIN_DELAY=3
NAVER_KEYWORD_REQUEST_MAX_DELAY=8
